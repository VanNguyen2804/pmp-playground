SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=YOUR_NEON_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Flyway: keep true only for the first deployment against the existing Neon schema.
FLYWAY_BASELINE_ON_MIGRATE=true
# Hibernate must validate, not update, once Flyway owns the schema.
DB_DDL_AUTO=validate
